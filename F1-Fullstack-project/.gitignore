# ─────────────────────────────────────────
#  .gitignore — F1 Fullstack Project
# ─────────────────────────────────────────

# ===== FRONTEND =====
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production
frontend/.env.*.local

# ===== BACKEND =====
# Virtual environment Python
Backend/venv/

# Cache FastF1 (bisa sangat besar, regenerasi otomatis)
Backend/cache/
Backend/*.json

# Python cache
Backend/__pycache__/
Backend/**/__pycache__/
Backend/*.pyc
Backend/*.pyo

# ===== UMUM =====
# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
